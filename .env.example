# Database URL (PostgreSQL or SQLite for development)
DATABASE_URL="file:./dev.db"

# Server Port & Environment
PORT=3000
NODE_ENV="development"

# Authentication JWT Secret (Rotated)
AUTH_SECRET="certiseal-sih-2026-production-jwt-secret-key-32-chars"

# Master AES-256-GCM Encryption Key (64 hex characters required, MUST FAIL FAST IF MISSING)
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
