# ============================================================
# CERTX — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================================
# Placeholders only. NEVER commit real credentials or private keys to Git.

# 1. DATABASE CONFIGURATION (PostgreSQL Production / Development)
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database_name>?schema=public"

# 2. SESSION AUTHENTICATION SECRET
AUTH_SECRET="<generate-a-long-random-secret-at-least-32-characters>"

# 3. KMS PROVIDER SELECTION ('local' for dev/demo, 'aws' for cloud production)
KMS_PROVIDER="local"

# Development Local KMS Master Key Encryption Key (KEK - 32-byte 64-char Hex)
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Production AWS KMS Configuration (Used when KMS_PROVIDER="aws")
AWS_REGION="us-east-1"
AWS_KMS_KEY_ID="arn:aws:kms:us-east-1:123456789012:key/xxxx-xxxx-xxxx"

# 4. DOCUMENT OCR PROVIDER SELECTION ('prototype' for regex, 'aws-textract' for cloud OCR)
OCR_PROVIDER="prototype"

# 5. PUBLIC PLATFORM APP URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
