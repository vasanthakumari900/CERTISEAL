# Database URL (PostgreSQL or SQLite)
DATABASE_URL="file:./dev.db"

# Server Environment & Port
PORT=3000
NODE_ENV="development"

# Authentication JWT Secret (MUST BE AT LEAST 32 CHARACTERS, NO DEFAULT FALLBACK)
AUTH_SECRET=""

# Master AES-256-GCM Encryption Key (MUST BE 64 HEX CHARACTERS, NO DEFAULT FALLBACK)
ENCRYPTION_MASTER_KEY=""
